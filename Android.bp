        "libdevice-mapper",
        "liblvm2-base",
        "libselinux",
    ],

    symlinks: [
        "lvchange",
        "lvconvert",
        "lvcreate",
        "lvdisplay",
        "lvextend",
        "lvmconfig",
        "lvmdevices",
        "lvmdiskscan",
