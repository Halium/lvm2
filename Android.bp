// Command-line generated headers for lvm tools
genrule {
    name: "lvm2_cmds_h",
    srcs: ["tools/command-lines.in"],
    out: ["cmds.h"],
    cmd: "echo '/* Auto-generated */' > $(out); " +
        "echo 'cmd(CMD_NONE, none)' >> $(out); " +
        "grep '^ID:' $(in) | sed 's/ID: *//' | sort -u | awk '{printf \"cmd(%s_CMD, %s)\\n\", $$1, $$1}' >> $(out); " +
        "echo 'cmd(CMD_COUNT, count)' >> $(out)",
}

genrule {
    name: "lvm2_command_count_h",
    srcs: ["tools/command-lines.in"],
    out: ["command-count.h"],
    cmd: "printf '/* Auto-generated */\\n#define COMMAND_COUNT ' > $(out); " +
        "grep -c '^ID:' $(in) >> $(out)",
}

genrule {
    name: "lvm2_command_lines_input_h",
    srcs: ["tools/command-lines.in"],
    out: ["command-lines-input.h"],
    cmd: "printf '/* Auto-generated */\\nstatic const char _command_input[] =\\n\\n\"' > $(out); " +
        "awk 'BEGIN {ORS = \"\\\\0\\\"\\n\\\"\"} !/^#/ && !/---/ && !/^$$/' $(in) >> $(out); " +
        "printf '\\\\0\\\\0\";\\n' >> $(out)",
}

