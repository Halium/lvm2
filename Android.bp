        "libdm/libdm-timestamp.c",
        "libdm/mm/dbg_malloc.c",
        "libdm/mm/pool.c",
        "libdm/regex/matcher.c",
        "libdm/regex/parse_rx.c",
        "libdm/regex/ttree.c",
