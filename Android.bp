package {
    default_applicable_licenses: ["external_lvm2_license"],
}

license {
    name: "external_lvm2_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-GPL-2.0",
        "SPDX-license-identifier-LGPL-2.1",
    ],
    license_text: [
        "COPYING",
        "COPYING.LIB",
    ],
}

cc_defaults {
    name: "lvm2_defaults",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-unused-function",
        "-Wno-unused-variable",
        "-Wno-missing-field-initializers",
        "-Wno-sign-compare",
        "-Wno-pointer-arith",
        "-Wno-macro-redefined",
        "-Wno-deprecated-declarations",
        "-Wno-null-pointer-subtraction",
        "-Wno-user-defined-warnings",
        "-D_FILE_OFFSET_BITS=64",
        "-D_GNU_SOURCE",
        "-D__linux__",
        // Force include configure.h and strings.h for Android
        "-include configure.h",
        "-include strings.h",
    ],
    local_include_dirs: [
        "include",
    ],
    generated_headers: [
        "lvm2_configure_h",
    ],
    recovery_available: true,
}

// Generate configure.h header
genrule {
    name: "lvm2_configure_h",
    srcs: [
        "include/configure.h.in",
        "VERSION_DM",
    ],
    out: ["configure.h"],
    cmd: "DM_VERSION=$$(cat $(location VERSION_DM) | head -n1 | sed 's/ .*//' | sed 's/-.*//'); " +
        "sed " +
        "-e 's|@DEFAULT_SYS_DIR@|\"/etc/lvm\"|g' " +
        "-e 's|@DEFAULT_PROFILE_DIR@|\"/etc/lvm/profile\"|g' " +
        "-e 's|@DEFAULT_ARCHIVE_SUBDIR@|\"archive\"|g' " +
        "-e 's|@DEFAULT_BACKUP_SUBDIR@|\"backup\"|g' " +
        "-e 's|@DEFAULT_CACHE_SUBDIR@|\"cache\"|g' " +
        "-e 's|@DEFAULT_LOCK_DIR@|\"/run/lock/lvm\"|g' " +
        "-e 's|@DEFAULT_RUN_DIR@|\"/run/lvm\"|g' " +
        "-e 's|#undef DEFAULT_RUN_DIR|#define DEFAULT_RUN_DIR \"/run/lvm\"|g' " +
        "-e 's|#undef DEFAULT_SYS_DIR|#define DEFAULT_SYS_DIR \"/etc/lvm\"|g' " +
        "-e 's|#undef LVMPERSIST_PATH|#define LVMPERSIST_PATH \"/system/bin/lvmpersist\"|g' " +
        "-e 's|#undef LVM_PATH|#define LVM_PATH \"/system/bin/lvm\"|g' " +
        "-e 's|#undef LVM_CONFIGURE_LINE|#define LVM_CONFIGURE_LINE \"Android\"|g' " +
        "-e 's|#undef MODULES_PATH|#define MODULES_PATH \"/system/lib/modules\"|g' " +
        "-e 's|@DEFAULT_DM_RUN_DIR@|\"/run\"|g' " +
        "-e 's|@DEFAULT_PID_DIR@|\"/run\"|g' " +
        "-e 's|@DEFAULT_PROC_DIR@|\"/proc\"|g' " +
        "-e 's|#undef DEFAULT_PROC_DIR|#define DEFAULT_PROC_DIR \"/proc\"|g' " +
        "-e 's|@DEFAULT_ETC_DIR@|\"/etc\"|g' " +
        "-e 's|#undef DEFAULT_ETC_DIR|#define DEFAULT_ETC_DIR \"/etc\"|g' " +
        "-e 's|#undef DEFAULT_LOCK_DIR|#define DEFAULT_LOCK_DIR \"/run/lock/lvm\"|g' " +
        "-e 's|#undef DEFAULT_CACHE_SUBDIR|#define DEFAULT_CACHE_SUBDIR \"cache\"|g' " +
        "-e 's|#undef DEFAULT_USE_BLKID_WIPING|#define DEFAULT_USE_BLKID_WIPING 0|g' " +
        "-e 's|#undef DEFAULT_USE_LVMPOLLD|#define DEFAULT_USE_LVMPOLLD 0|g' " +
        "-e 's|#undef DEFAULT_ARCHIVE_SUBDIR|#define DEFAULT_ARCHIVE_SUBDIR \"archive\"|g' " +
        "-e 's|#undef DEFAULT_BACKUP_SUBDIR|#define DEFAULT_BACKUP_SUBDIR \"backup\"|g' " +
        "-e 's|#undef DEFAULT_PROFILE_SUBDIR|#define DEFAULT_PROFILE_SUBDIR \"/etc/lvm/profile\"|g' " +
        "-e 's|#undef FSADM_PATH|#define FSADM_PATH \"/system/bin/fsadm\"|g' " +
        "-e 's|#undef LVRESIZE_FS_HELPER_PATH|#define LVRESIZE_FS_HELPER_PATH \"/system/bin/lvresize_fs_helper\"|g' " +
        "-e 's|#undef CACHE_CHECK_CMD|#define CACHE_CHECK_CMD \"\"|g' " +
        "-e 's|#undef CACHE_DUMP_CMD|#define CACHE_DUMP_CMD \"\"|g' " +
        "-e 's|#undef CACHE_REPAIR_CMD|#define CACHE_REPAIR_CMD \"\"|g' " +
        "-e 's|#undef CACHE_RESTORE_CMD|#define CACHE_RESTORE_CMD \"\"|g' " +
        "-e 's|#undef THIN_CHECK_CMD|#define THIN_CHECK_CMD \"\"|g' " +
        "-e 's|#undef THIN_DUMP_CMD|#define THIN_DUMP_CMD \"\"|g' " +
        "-e 's|#undef THIN_REPAIR_CMD|#define THIN_REPAIR_CMD \"\"|g' " +
        "-e 's|#undef THIN_RESTORE_CMD|#define THIN_RESTORE_CMD \"\"|g' " +
        "-e 's|#undef VDO_FORMAT_CMD|#define VDO_FORMAT_CMD \"\"|g' " +
        "-e 's|#undef DM_IOCTLS|#define DM_IOCTLS 1|g' " +
        "-e 's|#undef DEVMAPPER_SUPPORT|#define DEVMAPPER_SUPPORT 1|g' " +
        "-e 's|#undef DEVMAPPER|#define DEVMAPPER 1|g' " +
        "-e 's|#undef HAVE_SELINUX|#define HAVE_SELINUX 1|g' " +
        "-e 's|#undef HAVE_REALLOCARRAY|#define HAVE_REALLOCARRAY 1|g' " +
        "-e 's|#undef HAVE_MALLOC_H|#define HAVE_MALLOC_H 1|g' " +
        "-e 's|#undef HAVE_STDINT_H|#define HAVE_STDINT_H 1|g' " +
        "-e 's|#undef HAVE_INTTYPES_H|#define HAVE_INTTYPES_H 1|g' " +
        "-e 's|#undef HAVE_SYS_STAT_H|#define HAVE_SYS_STAT_H 1|g' " +
        "-e 's|#undef HAVE_STRING_H|#define HAVE_STRING_H 1|g' " +
        "-e 's|#undef HAVE_STRINGS_H|#define HAVE_STRINGS_H 1|g' " +
        "-e 's|#undef HAVE_UNISTD_H|#define HAVE_UNISTD_H 1|g' " +
        "-e 's|#undef HAVE_PTHREAD_H|#define HAVE_PTHREAD_H 1|g' " +
        "-e 's|#undef HAVE_FFS|#define HAVE_FFS 1|g' " +
        "-e 's|#undef HAVE_IOCTL|#define HAVE_IOCTL 1|g' " +
        "-e 's|#undef HAVE_SYS_IOCTL_H|#define HAVE_SYS_IOCTL_H 1|g' " +
        "-e 's|#undef HAVE_TERMIOS_H|#define HAVE_TERMIOS_H 1|g' " +
        "-e 's|#undef HAVE_GETOPTLONG|#define HAVE_GETOPTLONG 1|g' " +
        "-e 's|#undef HAVE_GETOPT_H|#define HAVE_GETOPT_H 1|g' " +
        "-e 's|#undef DEFAULT_USE_DEVICES_FILE|#define DEFAULT_USE_DEVICES_FILE 0|g' " +
        "-e 's|#undef DEFAULT_EVENT_ACTIVATION|#define DEFAULT_EVENT_ACTIVATION 0|g' " +
        "-e 's|#undef DEFAULT_SI_UNIT_CONSISTENCY|#define DEFAULT_SI_UNIT_CONSISTENCY 1|g' " +
        "-e 's|#undef DEFAULT_MIRROR_SEGTYPE|#define DEFAULT_MIRROR_SEGTYPE \"raid1\"|g' " +
        "-e 's|#undef DEFAULT_DM_ADD_NODE|#define DEFAULT_DM_ADD_NODE DM_ADD_NODE_ON_CREATE|g' " +
        "-e 's|#undef DEFAULT_DM_NAME_MANGLING|#define DEFAULT_DM_NAME_MANGLING DM_STRING_MANGLING_AUTO|g' " +
        "-e 's|#undef DM_DEVICE_UID|#define DM_DEVICE_UID 0|g' " +
        "-e 's|#undef DM_DEVICE_GID|#define DM_DEVICE_GID 0|g' " +
        "-e 's|#undef DM_DEVICE_MODE|#define DM_DEVICE_MODE 0600|g' " +
        "-e 's|#undef DEFAULT_RAID10_SEGTYPE|#define DEFAULT_RAID10_SEGTYPE \"raid10\"|g' " +
        "-e 's|#undef DEFAULT_SPARSE_SEGTYPE|#define DEFAULT_SPARSE_SEGTYPE \"thin\"|g' " +
        "-e 's|#undef LVM1_INTERNAL|/* #undef LVM1_INTERNAL */|g' " +
        "-e 's|#undef POOL_INTERNAL|/* #undef POOL_INTERNAL */|g' " +
        "-e 's|#undef SNAPSHOT_INTERNAL|#define SNAPSHOT_INTERNAL 1|g' " +
        "-e 's|#undef RAID_INTERNAL|#define RAID_INTERNAL 1|g' " +
        "-e 's|#undef THIN_INTERNAL|#define THIN_INTERNAL 1|g' " +
        "-e 's|#undef CACHE_INTERNAL|#define CACHE_INTERNAL 1|g' " +
        "-e 's|#undef WRITECACHE_INTERNAL|#define WRITECACHE_INTERNAL 1|g' " +
        "-e 's|#undef INTEGRITY_INTERNAL|#define INTEGRITY_INTERNAL 1|g' " +
        "-e 's|#undef VDO_INTERNAL|/* #undef VDO_INTERNAL */|g' " +
        "-e \"s|#undef DM_LIB_VERSION|#define DM_LIB_VERSION \\\"$$DM_VERSION\\\"|g\" " +
        "$(location include/configure.h.in) > $(out)",
}

// Generate lvm-version.h header
genrule {
    name: "lvm2_version_h",
    srcs: [
        "include/lvm-version.h.in",
        "VERSION",
        "VERSION_DM",
    ],
    out: ["lvm-version.h"],
    cmd: "VERSION=$$(cat $(location VERSION) | head -n1); " +
        "DM_VERSION=$$(cat $(location VERSION_DM) | head -n1 | sed 's/ .*//' | sed 's/-.*//'); " +
        "MAJOR=$$(echo $$VERSION | sed 's/\\([0-9]*\\)\\..*/\\1/'); " +
        "MINOR=$$(echo $$VERSION | sed 's/[0-9]*\\.\\([0-9]*\\)\\..*/\\1/'); " +
        "PATCH=$$(echo $$VERSION | sed 's/[0-9]*\\.[0-9]*\\.\\([0-9]*\\).*/\\1/'); " +
        "RELEASE=$$(echo $$VERSION | sed 's/.*-\\(.*\\) .*/\\1/'); " +
        "DATE=$$(echo $$VERSION | sed 's/.*(\\(.*\\))/\\1/'); " +
        "sed " +
        "-e \"s|@LVM_VERSION@|\\\"$$VERSION\\\"|g\" " +
        "-e \"s|@LVM_MAJOR@|$$MAJOR|g\" " +
        "-e \"s|@LVM_MINOR@|$$MINOR|g\" " +
        "-e \"s|@LVM_PATCHLEVEL@|$$PATCH|g\" " +
        "-e \"s|@LVM_LIBAPI@|$$MAJOR.$$MINOR|g\" " +
        "-e \"s|@LVM_RELEASE@|\\\"$$RELEASE\\\"|g\" " +
        "-e \"s|@LVM_RELEASE_DATE@|\\\"$$DATE\\\"|g\" " +
        "$(location include/lvm-version.h.in) > $(out); " +
        "echo \"#define DM_LIB_VERSION \\\"$$DM_VERSION\\\"\" >> $(out)",
}

// liblvm2-base - base data structures library for LVM2
cc_library_static {
    name: "liblvm2-base",
    defaults: ["lvm2_defaults"],

    srcs: [
        "base/data-struct/hash.c",
        "base/data-struct/list.c",
        "base/data-struct/radix-tree.c",
    ],

    local_include_dirs: [
        "base/data-struct",
    ],

    export_include_dirs: [
        "base/data-struct",
    ],

    generated_headers: [
        "lvm2_configure_h",
    ],
}

// libdaemonclient - daemon client library
cc_library_static {
    name: "libdaemonclient",
    defaults: ["lvm2_defaults"],

    srcs: [
        "libdaemon/client/daemon-io.c",
        "libdaemon/client/config-util.c",
        "libdaemon/client/daemon-client.c",
    ],

    local_include_dirs: [
        "libdaemon/client",
    ],

    export_include_dirs: [
        "libdaemon/client",
    ],

    generated_headers: [
        "lvm2_configure_h",
    ],

    static_libs: [
        "liblvm2-base",
    ],
}

// libdevice-mapper - internal device-mapper library (used by LVM2 tools)
// Note: This is NOT the public libdevmapper API library from libdm/
cc_library_static {
    name: "libdevice-mapper",
    defaults: ["lvm2_defaults"],

    srcs: [
        "device_mapper/datastruct/bitset.c",
        "device_mapper/ioctl/libdm-iface.c",
        "device_mapper/libdm-common.c",
        "device_mapper/libdm-config.c",
        "device_mapper/libdm-deptree.c",
        "device_mapper/libdm-file.c",
        "device_mapper/libdm-report.c",
        "device_mapper/libdm-string.c",
        "device_mapper/libdm-targets.c",
        "device_mapper/libdm-timestamp.c",
        "device_mapper/mm/pool.c",
        "device_mapper/raid/raid_parser.c",
        "device_mapper/regex/matcher.c",
        "device_mapper/regex/parse_rx.c",
        "device_mapper/regex/ttree.c",
        "device_mapper/vdo/status.c",
        "device_mapper/vdo/vdo_reader.c",
        "device_mapper/vdo/vdo_target.c",
    ],

    local_include_dirs: [
        "base/data-struct",
        "device_mapper",
        "device_mapper/ioctl",
        "device_mapper/misc",
    ],

    export_include_dirs: [
        "device_mapper",
    ],

    generated_headers: [
        "lvm2_configure_h",
        "lvm2_version_h",
    ],

    static_libs: [
        "liblvm2-base",
    ],

    shared_libs: [
        "libselinux",
    ],

    cflags: [
        "-DDEVICE_MAPPER=1",
        "-DDM_IOCTLS=1",
    ],
}

// libdevmapper - public device-mapper API backing dmsetup
cc_library_static {
