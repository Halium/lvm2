    ],

    target: {
        recovery: {
            exclude_shared_libs: [
                "libselinux",
            ],
            static_libs: [
                "libselinux",
            ],
        },
    },
}

// dmsetup - device-mapper setup tool
cc_binary {
    name: "dmsetup",
    defaults: ["lvm2_defaults"],
    recovery: true,

    srcs: [
        "libdm/dm-tools/dmsetup.c",
    ],

    local_include_dirs: [
        "libdm/dm-tools",
    ],

    generated_headers: [
        "lvm2_configure_h",
        "lvm2_version_h",
    ],

    static_libs: [
        "libdevmapper",
        "libselinux",
    ],
}
